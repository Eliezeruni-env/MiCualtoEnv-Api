# -----------------------------------------------------------------------------
# MiCualtoEnv - Variables de Entorno del Backend (API)
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5174

# Base de datos PostgreSQL
DB_USER=micualto_user
DB_PASSWORD=micualto_secret
DB_NAME=micualto_db
DB_PORT=5433
DATABASE_URL="postgresql://micualto_user:micualto_secret@localhost:5433/micualto_db?schema=public"

# Seguridad y Autenticación
JWT_SECRET=super_secret_jwt_micualto_key_dominicana_2026_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_key_micualto_dominicana_2026
COOKIE_SECRET=super_secret_cookie_parser_secret_key_2026

# Tasa de cambio por defecto (DOP por 1 USD)
DEFAULT_USD_RATE=60.25
